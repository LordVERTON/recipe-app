# Broco-Chou — exemple unique, sans secret réel.
# Local recommandé : npm run supabase:start puis npm run supabase:env.
# Ce script remplit .env.development.local et conserve .env.local.
# En configuration manuelle, copier vers .env.development.local (local)
# ou .env.local (Cloud explicitement choisi), puis remplir les valeurs.
# Ne jamais commiter les fichiers .env*.local ni partager leur contenu.

# Public : catalogue, Auth et Storage. Local : http://127.0.0.1:54321.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Facultatif ; les RPC et écritures restent sur public.recipes.
NEXT_PUBLIC_SUPABASE_RECIPES_TABLE=recipes

# Serveur seulement : nécessaire aux notifications Mailpit et à l'import local.
# Utiliser uniquement la clé de la même pile locale pour le développement.
# Les parcours Auth/recettes du navigateur de production n'en ont pas besoin.
SUPABASE_SERVICE_ROLE_KEY=

# Facultatif, serveur : reprise manuelle GET /api/recipe-notifications locale.
# Aucun cron de production n'est configuré.
# CRON_SECRET=

# Facultatif, scripts d'enrichissement Pexels seulement ; pas l'API images UI.
# PEXELS_API_KEY=

# Facultatif et privilégié : scripts City Café de lecture Cloud, dans .env.local.
# Ne pas copier en Preview ni l'utiliser pour les tests locaux.
# SUPABASE_PROD_SERVICE_ROLE_KEY=

# NEXT_PUBLIC_SUPABASE_LOCAL_PROXY est dérivée par next.config.mjs.
# TEST_APP_URL et PLAYWRIGHT_MODULE : variables de processus pour tests locaux.
# Référence détaillée : docs/TRD.md.
