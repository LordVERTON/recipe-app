# Copy this file to .env.development.local after `npm run supabase:start`.
# `npm run supabase:env` writes the current local values for you.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<local-anon-key>
NEXT_PUBLIC_SUPABASE_RECIPES_TABLE=recipes
SUPABASE_SERVICE_ROLE_KEY=<local-service-role-key>

# Production: https://recipe-app-alpha-wine.vercel.app
# Preview: explicit HTTPS origin, separately allowed in Supabase. Never a wildcard.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_TURNSTILE_REQUIRED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server only. Auth SMTP credentials belong in Supabase, not in Next.js.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=
RECIPE_REVIEW_NOTIFICATION_TO=
RECIPE_NOTIFICATION_EMAIL_ENABLED=false
CRON_SECRET=
